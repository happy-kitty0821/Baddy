# ── Badminton AI Coach — environment template ────────────────────────────
# Copy this file to .env at the PROJECT ROOT and fill in real values.
# Never commit .env to version control.
#
# IMPORTANT — path notes:
#   Both the API (run from backend/) and the Celery worker (run from project
#   root) load this same .env file.  Use ABSOLUTE paths for STORAGE_ROOT and
#   DATABASE_URL to guarantee both processes see the same files.

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (default for local development — no Docker required):
# The default below is derived automatically from the project root; you only
# need to set this if you want a custom path or PostgreSQL.
# DATABASE_URL=sqlite:////absolute/path/to/backend/data/badminton.db

# PostgreSQL (Linux production / integration testing):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/badminton

# ── Storage ──────────────────────────────────────────────────────────────
# MUST be an absolute path. Both the API and the worker must use the same
# directory. Relative paths cause the API and worker to store/find files
# in different locations depending on their working directory.
#
# Windows example:
# STORAGE_ROOT=C:/Users/YourName/Documents/Badminton AI Analysis/storage
#
# Linux example:
# STORAGE_ROOT=/opt/badminton-ai/storage
#
# Leave unset to use the automatic project-root default.
# STORAGE_ROOT=

# ── Redis / Celery ────────────────────────────────────────────────────────
# Required for the background worker. Redis must be running.
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────────────
# All three values are REQUIRED before the login endpoint works.
#
# JWT_SECRET: generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never use the placeholder below in production.
JWT_SECRET=change-me-before-first-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AUTH_USERNAME: the username for the single local user account.
AUTH_USERNAME=admin

# AUTH_PASSWORD_HASH: bcrypt hash of the user's password.
# Generate with:
#   python -c "from passlib.context import CryptContext; \
#              print(CryptContext(['bcrypt']).hash('your_password_here'))"
# Paste the full $2b$... string below. Never store the plain password.
AUTH_PASSWORD_HASH=

# ── Upload limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=2048
MAX_DURATION_MINUTES=180

# ── Optional: Ollama coaching LLM (Phase 6+) ─────────────────────────────
# Leave empty to disable. App functions without this.
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_MODEL=

# ── FFmpeg location ───────────────────────────────────────────────────────
# Optional. Set to the directory containing ffmpeg and ffprobe binaries.
#
# WHEN TO SET THIS:
#   The Celery worker runs in its own process and may not inherit the shell
#   PATH where FFmpeg was installed.  If you see FFPROBE_ERROR in the worker,
#   set this to the bin directory that contains ffprobe.
#
# Windows (winget install Gyan.FFmpeg):
#   After running winget, find the exact path with:
#     Get-ChildItem "$env:LOCALAPPDATA\Microsoft\WinGet\Packages" -Recurse -Filter ffprobe.exe | Select FullName
#   Then set FFMPEG_BIN to its parent directory, e.g.:
#   FFMPEG_BIN=C:/Users/YourName/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0.2-full_build/bin
#
# Linux / Ubuntu (apt install ffmpeg):
#   Usually not needed — apt puts ffprobe in /usr/bin which is always on PATH.
#   Only set this if you installed FFmpeg manually to a non-standard location:
#   FFMPEG_BIN=/usr/local/ffmpeg/bin
#
# Leave empty to rely on PATH auto-detection (works when all processes share a shell).
FFMPEG_BIN=

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Vision / inference (Phase 2) ──────────────────────────────────────────
# Player detection + pose estimation + tracking settings.
#
# INFERENCE_DEVICE: which device the vision model runs on.
#   auto  — use CUDA if available, otherwise fall back to CPU (default).
#   cpu   — force CPU (use this on the Windows dev box to avoid installing
#           GPU/CUDA torch).
#   cuda  — require a GPU; the worker fails the run with GPU_UNAVAILABLE if
#           CUDA is not available.
INFERENCE_DEVICE=auto

# VISION_TARGET_FPS: how many frames per second the pipeline analyses.
# The worker dynamically computes a frame skip from the source fps so this
# works for any source framerate (e.g. 30 or 60 fps).  0 means every frame.
VISION_TARGET_FPS=60

# VISION_CONFIDENCE: minimum detection confidence for a player/keypoint.
VISION_CONFIDENCE=0.3

# VISION_IMG_SIZE: YOLO inference image size in pixels (square).
VISION_IMG_SIZE=640

# MODEL_WEIGHTS_DIR: optional directory for model weight files (.pt).
# Leave empty to use the Ultralytics default cache location.
MODEL_WEIGHTS_DIR=
